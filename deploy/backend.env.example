# Copy to deploy/backend.env on the server (never commit it). Settings for the API and the
# worker; every option is described in the repository's .env.example.
LOG_LEVEL=INFO
FRONTEND_URL=https://leads.bricbybric.ae
CORS_ORIGINS=["https://leads.bricbybric.ae"]

# Required. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Required for mailbox passwords, dashboard-saved secrets and MCP client secrets:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional here: WhatsApp, Slack, Teams and Microsoft sign-in can be set in the dashboard
# (Settings > Integrations) instead.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Optional error reporting for the API and worker. Empty: nothing is sent.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# First admin and demo reps for `python -m app.scripts.seed`.
SEED_ADMIN_EMAIL=admin@bricbybric.ae
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
