# Copy to deploy/compose.env on the server (never commit it). Read by Compose itself.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Image names and tag. Leave as-is to build on the server; set IMAGE_PREFIX to
# ghcr.io/breadstick-crumbs/lead-platform (see .github/workflows/images.yml) and IMAGE_TAG to a commit SHA to pull CI images.
IMAGE_PREFIX=lead-platform
IMAGE_TAG=latest
# Browser error reporting (public DSN of a Sentry browser project). Empty: off.
VITE_SENTRY_DSN=
