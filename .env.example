# Copy to backend/.env for local dev. Never commit real values.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://leads:leads@localhost:5442/leads
CORS_ORIGINS=["http://localhost:5173"]

# Auth: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave unset in development to use the built-in dev placeholder; required in production.
# JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
# OAuth tokens for MCP clients (Claude, ChatGPT). The MCP endpoint is <FRONTEND_URL>/mcp.
MCP_ACCESS_TTL_MINUTES=60
MCP_REFRESH_TTL_DAYS=30
# Secure flag on the refresh cookie (default: on when ENVIRONMENT=production)
# COOKIE_SECURE=true
# Fernet key for mailbox passwords and MCP client secrets (needed for AI apps that register
# with a client secret): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Meta WhatsApp Cloud API
# WhatsApp, Slack, Teams and Microsoft sign-in can also be set in the dashboard
# (Settings > Integrations), which overrides the values here.
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Observability (optional). Without a DSN nothing is sent anywhere.
SENTRY_DSN=
# Share of requests traced for performance (0 to 1); errors are always reported.
SENTRY_TRACES_SAMPLE_RATE=0
# Build identifier attached to Sentry events (the production images set it to the commit).
APP_RELEASE=

# Sign in with Microsoft (Entra ID app registration; see docs/MICROSOFT_SIGN_IN.md)
FRONTEND_URL=http://localhost:5173
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=http://localhost:5173/api/v1/auth/microsoft/callback

# Seed accounts for `uv run python -m app.scripts.seed` (dev/demo only)
SEED_ADMIN_EMAIL=admin@tawasol.test
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# Escalation chat channels (incoming-webhook URLs are secrets)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Reports bucket days in this time zone
REPORTING_TIMEZONE=Asia/Dubai
