# Copy to backend/.env for local dev. Never commit real values.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://leads:leads@localhost:5442/leads
CORS_ORIGINS=["http://localhost:5173"]

# Auth: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave unset in development to use the built-in dev placeholder; required in production.
# JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
# Secure flag on the refresh cookie (default: on when ENVIRONMENT=production)
# COOKIE_SECURE=true
# Fernet key for mailbox credentials: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Meta WhatsApp Cloud API
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Observability (optional)
SENTRY_DSN=

# Seed accounts for `uv run python -m app.scripts.seed` (dev/demo only)
SEED_ADMIN_EMAIL=admin@tawasol.test
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
